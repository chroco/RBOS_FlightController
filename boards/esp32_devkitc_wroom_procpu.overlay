/ {
	aliases {
		led0 = &led0;
		receiver0 = &receiver0;
		receiver1 = &receiver1;
		receiver2 = &receiver2;
		receiver3 = &receiver3;
		receiver4 = &receiver4;
		receiver5 = &receiver5;
	};

  zephyr,user {
		io-channels = <&adc1 4>;
	};

  leds {
		compatible = "gpio-leds";
		led0: led_0 {
			gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
			label = "LED 0";
		};
	};

	receiver {
		compatible = "gpio-keys";

		receiver0: receiver_0 {                 // roll
			gpios = <&gpio1 4 GPIO_ACTIVE_HIGH>;  // pin 36
      zephyr,code = <INPUT_KEY_0>;
			label = "Receiver 0";
		};

		receiver1: receiver_1 { // pitch
			gpios = <&gpio1 7 GPIO_ACTIVE_HIGH>;  // pin 39
      zephyr,code = <INPUT_KEY_1>;
			label = "Receiver 1";
		};

		receiver2: receiver_2 { // throttle
			gpios = <&gpio1 2  GPIO_ACTIVE_HIGH>; // pin 34
      zephyr,code = <INPUT_KEY_2>;
			label = "Receiver 2";
		};

		receiver3: receiver_3 { // pitch
			gpios = <&gpio1 3 GPIO_ACTIVE_HIGH>; // pin 35
      zephyr,code = <INPUT_KEY_3>;
			label = "Receiver 3";
		};

		receiver4: receiver_4 { //vra
			gpios = <&gpio1 0 GPIO_ACTIVE_HIGH>; // pin 32
      zephyr,code = <INPUT_KEY_4>;
			label = "Receiver 4";
		};

		receiver5: receiver_5 { //vrb
			gpios = <&gpio1 1 GPIO_ACTIVE_HIGH>; // pin 33
      zephyr,code = <INPUT_KEY_5>;
			label = "Receiver 5";
		};
	};

	servos {
		servo0: servo_0 {
			compatible = "pwm-servo";
			pwms = <&mcpwm0 0 PWM_MSEC(20) PWM_POLARITY_NORMAL>; 
			min-pulse = <PWM_USEC(1000)>;
			max-pulse = <PWM_USEC(2000)>;
		};
		servo1: servo_1 {
			compatible = "pwm-servo";
			pwms = <&mcpwm0 0 PWM_MSEC(20) PWM_POLARITY_NORMAL>; 
			min-pulse = <PWM_USEC(1000)>;
			max-pulse = <PWM_USEC(2000)>;
		};
		servo2: servo_2 {
			compatible = "pwm-servo";
			pwms = <&mcpwm0 0 PWM_MSEC(20) PWM_POLARITY_NORMAL>; 
			min-pulse = <PWM_USEC(1000)>;
			max-pulse = <PWM_USEC(2000)>;
		};
		servo3: servo_3 {
			compatible = "pwm-servo";
			pwms = <&mcpwm0 0 PWM_MSEC(20) PWM_POLARITY_NORMAL>; 
			min-pulse = <PWM_USEC(1000)>;
			max-pulse = <PWM_USEC(2000)>;
		};
	};
};

&adc1 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	channel@4 {
		reg = <4>;
		zephyr,gain = "ADC_GAIN_1_4";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		//zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 4000)>;
		zephyr,resolution = <12>;
	};
};

&pinctrl {
	mcpwm0_default: mcpwm0_default {
		group1 {
			pinmux = <MCPWM0_OUT0A_GPIO14>, // FR pin
							 <MCPWM0_OUT0A_GPIO27>, // BR pin
							 <MCPWM0_OUT0A_GPIO26>, // BL pin
							 <MCPWM0_OUT0A_GPIO25>; // FL pin
		};
	};
};

&mcpwm0 {
	pinctrl-0 = <&mcpwm0_default>;
	pinctrl-names = "default";
	prescale = <255>;
	prescale-timer0 = <103>;
	status = "okay";
};

&i2c0 {
	mpu6050@68 {
		compatible = "invensense,mpu6050";
		reg = <0x68>;
		status = "okay";
		int-gpios = <&gpio0 23 GPIO_ACTIVE_HIGH>;
	};

	bmp390@77 {
		compatible = "bosch,bmp390";
		reg = <0x77>;
		status = "okay";
		int-gpios = <&gpio0 19 GPIO_ACTIVE_HIGH>;
		odr = "200";
		osr-press = <1>;
		osr-temp = <1>;
		iir-filter = <3>;

		label = "BMP390";
	};
};
