/ {
	aliases {
		led0 = &led0;
		receiver0 = &receiver0;
		receiver1 = &receiver1;
		receiver2 = &receiver2;
		receiver3 = &receiver3;
		receiver4 = &receiver4;
		receiver5 = &receiver5;
//		servo0 = &servo0;
		gnss = &gnss;
	};

	pwm_loopback_0 {
		compatible = "test-pwm-loopback";
		/* first index must be a 32-Bit timer */
		pwms = <&mcpwm0 0 0 PWM_POLARITY_NORMAL>,
		       <&mcpwm0 6 0 PWM_POLARITY_NORMAL>;
	};

	leds {
		compatible = "gpio-leds";
		led0: led_0 {
			gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
			//gpios = <&gpio0 15 GPIO_ACTIVE_HIGH>;
			label = "LED 0";
		};
	};

	receiver {
		compatible = "gpio-keys";

		receiver0: receiver_0 { // roll
			gpios = <&gpio1 4 GPIO_ACTIVE_HIGH>; // pin 36
      zephyr,code = <INPUT_KEY_0>;
			label = "Receiver 0";
		};

		receiver1: receiver_1 { // pitch
			gpios = <&gpio1 7 GPIO_ACTIVE_HIGH>; // pin 39
      zephyr,code = <INPUT_KEY_1>;
			label = "Receiver 1";
		};

		receiver2: receiver_2 { // throttle
			gpios = <&gpio1 2  GPIO_ACTIVE_HIGH>; // pin 34
      zephyr,code = <INPUT_KEY_2>;
			label = "Receiver 2";
		};

		receiver3: receiver_3 { // pitch
			gpios = <&gpio1 3 GPIO_ACTIVE_HIGH>; // pin 35
      zephyr,code = <INPUT_KEY_3>;
			label = "Receiver 3";
		};

		receiver4: receiver_4 { //vra
			gpios = <&gpio1 0 GPIO_ACTIVE_HIGH>; // pin 32
      zephyr,code = <INPUT_KEY_4>;
			label = "Receiver 4";
		};

		receiver5: receiver_5 { //vrb
			gpios = <&gpio1 1 GPIO_ACTIVE_HIGH>; // pin 33
      zephyr,code = <INPUT_KEY_5>;
			label = "Receiver 5";
		};
	};

	servos {
		servo0: servo_0 {
			compatible = "pwm-servo";
			pwms = <&mcpwm0 0 PWM_MSEC(20) PWM_POLARITY_NORMAL>; 
			min-pulse = <PWM_USEC(1000)>;
			max-pulse = <PWM_USEC(2000)>;
		};
		servo1: servo_1 {
			compatible = "pwm-servo";
			pwms = <&mcpwm0 0 PWM_MSEC(20) PWM_POLARITY_NORMAL>; 
			min-pulse = <PWM_USEC(1000)>;
			max-pulse = <PWM_USEC(2000)>;
		};
		servo2: servo_2 {
			compatible = "pwm-servo";
			pwms = <&mcpwm0 0 PWM_MSEC(20) PWM_POLARITY_NORMAL>; 
			min-pulse = <PWM_USEC(1000)>;
			max-pulse = <PWM_USEC(2000)>;
		};
		servo3: servo_3 {
			compatible = "pwm-servo";
			pwms = <&mcpwm0 0 PWM_MSEC(20) PWM_POLARITY_NORMAL>; 
			min-pulse = <PWM_USEC(1000)>;
			max-pulse = <PWM_USEC(2000)>;
		};
	};
};

&uart2 {
	status = "okay";
	current-speed = <115200>;

	gnss: u-blox,m8 {
		status = "okay";
		compatible = "u-blox,m8";
		uart-baudrate = <115200>;
	};
};

&pinctrl {
	mcpwm0_default: mcpwm0_default {
		group1 {
			pinmux = <MCPWM0_OUT0A_GPIO14>, // FR pin
							 <MCPWM0_OUT0A_GPIO27>, // BR pin
							 <MCPWM0_OUT0A_GPIO26>, // BL pin
							 <MCPWM0_OUT0A_GPIO25>; // FL pin
		};
	};
};

&mcpwm0 {
	pinctrl-0 = <&mcpwm0_default>;
	pinctrl-names = "default";
	prescale = <255>;
	prescale-timer0 = <103>;
	status = "okay";
};

&i2c0 {
	mpu6050@68 {
		compatible = "invensense,mpu6050";
		reg = <0x68>;
		status = "okay";
		int-gpios = <&gpio0 23 GPIO_ACTIVE_HIGH>;
	};

	bmp390@77 {
		compatible = "bosch,bmp390";
		reg = <0x77>;
		status = "okay";
		int-gpios = <&gpio0 19 GPIO_ACTIVE_HIGH>;
		odr = "200";
		osr-press = <1>;
		osr-temp = <1>;
		iir-filter = <3>;

		label = "BMP390";
	};
};

&spi3 {
	status = "okay";
	cs-gpios = <&gpio0 5 GPIO_ACTIVE_LOW>;

	sdhc2: sdhc@0 {
		compatible = "zephyr,sdhc-spi-slot";
		reg = <0>;
		status = "okay";
		mmc {
			compatible = "zephyr,sdmmc-disk";
			disk-name = "SD";
			status = "okay";
		};
		spi-max-frequency = <24000000>;
	};
};

